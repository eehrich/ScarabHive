#!/usr/bin/env bash
# pre-commit hook: validate backlog
# Install: git config core.hooksPath .githooks

PY=${PY:=python}
$PY .prompts/scripts/update_backlog.py
RC=$?
if [ $RC -ne 0 ]; then
  echo "Backlog validation failed (exit $RC). Fix .prompts/backlog.md and try again."
  exit $RC
fi

git diff --exit-code -- .prompts/backlog.md >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "Commit would modify .prompts/backlog.md. Please review and commit the updated backlog separately."
  git --no-pager diff -- .prompts/backlog.md
  exit 1
fi

exit 0

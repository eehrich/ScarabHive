# logs/ at any depth; the top-level one ships empty (logs/.gitkeep)
logs/
!/logs/
/logs/*
!/logs/.gitkeep
dist/
build/
external/
tmp/
MagicMock/
nul

tmp_backlog.md

# batch test outputs of plugin packages (per-run logs + JSON dumps)
src/plugins*/**/batch_logs/

# Runtime data -- the top-level folder only; data/ folders inside packages
# stay tracked. The folder itself ships empty (data/.gitkeep).
/data/*
!/data/.gitkeep
tests/data/


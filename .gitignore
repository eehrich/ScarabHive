*.log
# Server operator secrets (tokens, deploy keys) and the backups the admin
# panel writes on every change. `envrc.example` (no dot) stays tracked.
.envrc
.envrc.*
# API keys and tokens; only the template config/secrets.env.example is tracked.
config/secrets.env
# Settings for ONE machine only (network, log retention): read after all
# includes, so they win over everything (auth and paths too).
config/local.yaml
# This machine's keys (setup panel, install scripts), read before secrets.env.
config/local.env
# Safety net for credentials that never belong in the repo -- deliberately
# concrete names: a pattern like `credentials.*` would also hide a module
# credentials.py. The .example templates stay tracked.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
client_secret*.json
service-account*.json
# Local, private configuration
config.local.yaml
*.local.yaml
config/agents_priv/

# Zugangsdaten für das Agent-System — VORLAGE.
#
# Kopieren nach `config/secrets.env` und die Werte eintragen:
#     cp config/secrets.env.example config/secrets.env
#
# ZUM AKTUELLEN STAND ist `config/secrets.env` bewusst MIT versioniert: die
# Keys liegen ohnehin in der Git-Historie, und gebündelt in einer Datei sind
# sie ein Ziel statt 73 Fundstellen. Vor einer Veröffentlichung müssen die
# Keys rotiert und die Historie bereinigt werden — ab dann gehört
# `secrets.env` in .gitignore und nur noch diese Vorlage ins Repo.
#
# Format: KEY=wert, eine Zeile je Eintrag. Anführungszeichen sind optional,
# Zeilen mit `#` sind Kommentare. Kein Shell-Escaping — der Wert wird
# genommen, wie er dasteht (ein API-Key ist eine undurchsichtige Zeichenkette).
#
# GELESEN WIRD DIE DATEI beim Laden der Config. Die YAMLs referenzieren die
# Werte als ${VARIABLE}; eine echte Umgebungsvariable GEWINNT immer gegen
# diese Datei. Damit konfiguriert man den Server über systemd/CI und braucht
# dort gar keine secrets.env — und eine veraltete Entwickler-Datei auf
# derselben Maschine kann die Server-Zugangsdaten nicht still ersetzen.
#
# Ein Eintrag, der fehlt, wird beim Laden mit seinem NAMEN gewarnt. Er wird
# nicht still zu einer leeren Zeichenkette, die Stunden später als
# rätselhafter 401 beim Provider auftaucht.

# --- LLM-Provider (config/llm.yaml, config/llm_openrouter.yaml) -------------

# OpenRouter — mit Abstand der meistgenutzte Zugang (37 Modelleinträge):
# GPT-5.x, Claude, Gemini, DeepSeek, Grok, MiniMax, GLM, Kimi, Llama.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI direkt (Responses-API und httpx-Route).
OPENAI_API_KEY=sk-proj-...

# TypeSafe direkt — nur für Decision-Modelle mit `provider: systemone_decisions`
# ohne eigenen `url`; Jev über OpenRouter braucht ihn nicht.
# TYPESAFE_API_KEY=

# Anthropic direkt.
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini direkt — auch für die TTS-Modelle und die Batch-Provider.
GOOGLE_API_KEY=AIza...

# DeepSeek direkt (OpenAI-kompatibel, api.deepseek.com).
DEEPSEEK_API_KEY=sk-...

# --- Plugins (config/plugins.yaml) -----------------------------------------

# Tavily-Websuche (Plugin `tavily_search`).
TAVILY_API_KEY=tvly-...

# --- Externe MCP-Server (config/mcp_servers.yaml) ---------------------------
# Smithery-Gateway hostet mehrere der eingetragenen MCP-Server; Key und Profil
# stecken dort als Query-Parameter in der URL.
SMITHERY_API_KEY=...
SMITHERY_PROFILE=...

# X/Twitter-Zugang des x_tools-Servers.
X_BEARER_TOKEN=...
X_ACCESS_TOKEN=...

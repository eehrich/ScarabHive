{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "editor.wordWrap": "on",
  "python.testing.unittestEnabled": false,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "yaml.schemas": {
    "./schemas/llm-config.schema.json": [
      "config/llm.yaml",
      "config/llm_openrouter.yaml"
    ],
    "./schemas/main-config.schema.json": [
      "config/config.yaml"
    ],
    "./schemas/plugins-config.schema.json": [
      "config/plugins.yaml"
    ],
    "./schemas/config-part.schema.json": [
      "config/agents/*.yaml",
      "config/mcp_servers.yaml",
      "src/plugins*/*/agents/*.yaml"
    ]
  },
  "yaml.customTags": [
    "!include"
  ]
}

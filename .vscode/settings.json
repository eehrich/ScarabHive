{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [],
  "editor.wordWrap": "on",
  "python.testing.unittestEnabled": false,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "yaml.schemas": {
    "./schemas/llm-config.schema.json": [
      "config/llm.yaml",
      "config/llm_openrouter.yaml"
    ],
    "./schemas/main-config.schema.json": [
      "config/config.yaml"
    ],
    "./schemas/plugins-config.schema.json": [
      "config/plugins.yaml"
    ],
    "./schemas/config-part.schema.json": [
      "config/agents/*.yaml",
      "config/mcp_servers.yaml",
      "src/plugins*/*/agents/*.yaml"
    ]
  },
  "yaml.customTags": [
    "!include"
  ],
  "files.watcherExclude": {
    "**/data/**": true,
    "**/.claude/worktrees/**": true
  },
  "search.exclude": {
    "data/**": true,
    "external/**": true,
    "tmp/**": true,
    ".claude/worktrees/**": true
  },
  "python.analysis.exclude": [
    "data",
    "external",
    "tmp",
    ".claude/worktrees",
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    ".venv"
  ],
  "git.detectWorktrees": false,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    "data",
    ".claude/worktrees"
  ]
}

{
  // Debug configurations for the Python Debugger extension (debugpy ships with it).
  // The API runs through uvicorn directly, one process, as .claude/skills/verify starts it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "agent_system.app:build_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "${input:apiPort}",
        "--timeout-graceful-shutdown",
        "5"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8:replace"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "agent-cli",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_system.agent_cli",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8:replace"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "agent-run",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_system.agent_run",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8:replace"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8:replace"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: test, file or folder",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${input:pytestTarget}", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8:replace"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "apiPort",
      "type": "promptString",
      "description": "Port for the API (8000 is the usual one; another, e.g. 8123, beside a running API)",
      "default": "8000"
    },
    {
      "id": "pytestTarget",
      "type": "promptString",
      "description": "pytest target, e.g. tests/agent/test_run_questions.py::test_x or src/plugins/stategraph/tests"
    }
  ]
}

{
  "$defs": {
    "Activity_agent": {
      "additionalProperties": false,
      "properties": {
        "advanced": {
          "default": false,
          "description": "use the agent's advanced model profile",
          "title": "Advanced",
          "type": "boolean"
        },
        "agent": {
          "description": "agent name: a literal, or {{ params.x }} with an enum; any configured agent",
          "title": "Agent",
          "type": "string"
        },
        "check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a companion function name (or package.module:function), fn(out) or fn(sg, out), sync or async: raising ValueError sends its message back to the same instance as feedback (parse_retries rounds); its sg.tool() calls belong to the answer they check",
          "title": "Check"
        },
        "continue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "instance id (template) of this agent to follow up instead of spawning",
          "title": "Continue"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "parse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a companion function name (or package.module:function), fn(text) -> out; raising ValueError sends its message back to the same instance as feedback (parse_retries times)",
          "title": "Parse"
        },
        "parse_retries": {
          "default": 1,
          "description": "feedback rounds for schema/parse/check failures",
          "maximum": 5,
          "minimum": 0,
          "title": "Parse Retries",
          "type": "integer"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON schema: the answer is parsed as JSON and validated",
          "title": "Schema"
        },
        "task": {
          "description": "the task text (template)",
          "title": "Task"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        },
        "vars": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "description": "agent template vars for this call, over the machine's: a map of templates, or one template that renders to an object of names",
          "title": "Vars"
        }
      },
      "required": [
        "agent",
        "task"
      ],
      "title": "Agent activity (agent)",
      "type": "object"
    },
    "Activity_call": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "description": "keyword arguments (templates)",
          "title": "Args",
          "type": "object"
        },
        "call": {
          "description": "a companion function name, or package.module:function",
          "title": "Call",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "call"
      ],
      "title": "Python activity (call)",
      "type": "object"
    },
    "Activity_callback": {
      "additionalProperties": false,
      "properties": {
        "callback": {
          "description": "the event its URL sends -- one this machine declares (a literal)",
          "title": "Callback",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "expires": {
          "default": "168h",
          "description": "how long the URL holds (a duration, at most 720h)",
          "title": "Expires"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the frame the event goes to (template); default: the one that takes it",
          "title": "Frame"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "callback"
      ],
      "title": "Callback URL activity (callback)",
      "type": "object"
    },
    "Activity_decide": {
      "additionalProperties": false,
      "properties": {
        "advanced": {
          "default": false,
          "description": "with by: use the agent's advanced model profile",
          "title": "Advanced",
          "type": "boolean"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an agent that decides instead of a decision model: a literal, or {{ params.x }} with an enum; it answers in JSON, checked like a schema (confidence and probabilities are null)",
          "title": "By"
        },
        "criteria": {
          "default": null,
          "description": "single question: its criteria -- choice: {option: meaning}; score: [lowest, ..., highest]",
          "title": "Criteria",
          "x-yaml": true
        },
        "decide": {
          "description": "noul: probability of yes; choice: one option of criteria; score: a point on criteria's scale; questions: several named questions in one call",
          "enum": [
            "noul",
            "choice",
            "score",
            "questions"
          ],
          "title": "Decide",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "input": {
          "description": "the content to judge (template: text or object, not empty)",
          "title": "Input"
        },
        "parse_retries": {
          "default": 1,
          "description": "with by: feedback rounds for an unusable answer",
          "maximum": 5,
          "minimum": 0,
          "title": "Parse Retries",
          "type": "integer"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "decision profile (llm_system.decision_profiles); default: the configured default",
          "title": "Profile"
        },
        "question": {
          "default": null,
          "description": "single question (template)",
          "title": "Question"
        },
        "questions": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/QuestionSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "decide: questions -> name: question",
          "title": "Questions"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "decide",
        "input"
      ],
      "title": "Decision activity (decide)",
      "type": "object"
    },
    "Activity_emit": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "emit": {
          "description": "what the run tells about itself (template): a status line for its caller, a message in its session",
          "title": "Emit"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "emit"
      ],
      "title": "Emit activity (emit)",
      "type": "object"
    },
    "Activity_machine": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "machine": {
          "description": "import alias of the submachine",
          "title": "Machine",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "parameters (templates)",
          "title": "Params",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "machine"
      ],
      "title": "Submachine activity (machine)",
      "type": "object"
    },
    "Activity_map": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "default": "item",
          "description": "name of the item variable in each's templates",
          "title": "As",
          "type": "string"
        },
        "concurrency": {
          "default": 1,
          "description": "items at once; 1 = strictly in list order",
          "maximum": 64,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "each": {
          "additionalProperties": true,
          "description": "the activity run per item",
          "title": "Each",
          "type": "object"
        },
        "fail": {
          "default": "fast",
          "description": "as in parallel",
          "enum": [
            "fast",
            "collect"
          ],
          "title": "Fail",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "map": {
          "description": "Python expression giving the list of items",
          "title": "Map",
          "type": "string"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python expression over out (and the item, index): the first item in list order it holds for ends the map -- out = the results up to it; later items are cancelled or never start",
          "title": "Until"
        }
      },
      "required": [
        "map",
        "each"
      ],
      "title": "Map activity (map)",
      "type": "object"
    },
    "Activity_parallel": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "fail": {
          "default": "fast",
          "description": "fast: the first failure cancels the rest and is the error; collect: out[branch] = {status, out | error}",
          "enum": [
            "fast",
            "collect"
          ],
          "title": "Fail",
          "type": "string"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "join": {
          "anyOf": [
            {
              "enum": [
                "all",
                "first"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/JoinCount"
            }
          ],
          "default": "all",
          "description": "all: every branch; first: the first branch that succeeds ends it, the others are cancelled -- out = {that branch: out}; {count: n}: the first n that succeed. With first or count a failed branch only counts against them: too many raise join_failed",
          "title": "Join"
        },
        "parallel": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "branch name -> activity",
          "title": "Parallel",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        }
      },
      "required": [
        "parallel"
      ],
      "title": "Parallel activity (parallel)",
      "type": "object"
    },
    "Activity_tool": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "description": "arguments (templates)",
          "title": "Args",
          "type": "object"
        },
        "description": {
          "default": "",
          "description": "what the activity is for, for whoever reads the machine",
          "title": "Description",
          "type": "string"
        },
        "error_if": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python expression over out: true makes the result an error (type tool_failed)",
          "title": "Error If"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "may a resumed run start it again if it was in flight at the crash? default: true, tool: false",
          "title": "Idempotent"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "{attempts, backoff, errors}: try again before the failure becomes the state's error event; default: one attempt"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deadline of one attempt",
          "title": "Timeout"
        },
        "tool": {
          "description": "flat tool name as agents see it, e.g. json_store_read",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Tool activity (tool)",
      "type": "object"
    },
    "BackoffSpec": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "default": 2.0,
          "maximum": 10.0,
          "minimum": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "initial": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 1,
          "title": "Initial"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 60,
          "title": "Max"
        }
      },
      "title": "BackoffSpec",
      "type": "object"
    },
    "EventSpec": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON schema of the payload",
          "title": "Data"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "EventSpec",
      "type": "object"
    },
    "JoinCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "description": "how many branches must succeed",
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "title": "JoinCount",
      "type": "object"
    },
    "LimitsSpec": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "leaf activities (agent, tool, decide, call) of the whole run at once; the others wait for their turn before they start",
          "title": "Concurrency"
        },
        "max_steps": {
          "default": 1000,
          "description": "macro steps per machine instance",
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "wall time of a whole run",
          "title": "Timeout"
        }
      },
      "title": "LimitsSpec",
      "type": "object"
    },
    "LocalMachineSpec": {
      "additionalProperties": false,
      "description": "A machine inside another machine's file (``machines: {name: ...}``): ``machine: <name>`` runs it in its own\nframe. It shares that file's companion module and imports, and runs no other machine of the file.",
      "properties": {
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "description": {
          "default": "",
          "title": "Description",

      "title": "Vars"
    },
    "vars_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "agent whose configured template_vars lie under vars",
      "title": "Vars From"
    }
  },
  "required": [
    "stategraph",
    "id",
    "initial",
    "states"
  ],
  "title": "stategraph machine (format 1)",
  "type": "object"

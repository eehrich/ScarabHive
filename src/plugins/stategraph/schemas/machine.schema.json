  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One machine file.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/MachineAgentSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "offer this machine as an agent: SAM spawns, AgentCaller and /events address it by name -- declared by every process at its start, no config entry"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "events": {
      "additionalProperties": {
        "$ref": "#/$defs/EventSpec"
      },
      "description": "named events this machine accepts",
      "title": "Events",
      "type": "object"
    },
    "finally": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "an activity that runs once when the machine frame ends, whatever the cause (final state, failure, cancel); reads ending",
      "title": "Finally"
    },
    "group": {
      "default": "",
      "description": "its folder in the panel's machine list, nested by / (Reviews/nightly); empty: the folder of where it comes from",
      "title": "Group",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "imports": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "alias -> ./relative.yaml or machine id",
      "title": "Imports",
      "type": "object"
    },
    "initial": {
      "title": "Initial",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/LimitsSpec"
    },
    "machines": {
      "additionalProperties": {
        "$ref": "#/$defs/LocalMachineSpec"
      },
      "description": "machines inside this file: machine: <name> runs one in its own frame; they share the companion module and the imports",
      "title": "Machines",
      "type": "object"
    },
    "notes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "name -> free text for the reader, drawn as a note on the canvas; the engine ignores it",
      "title": "Notes",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/ParamSpec"
      },
      "title": "Params",
      "type": "object"
    },
    "python": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "companion module, relative to this file",
      "title": "Python"
    },
    "resources": {
      "additionalProperties": {
        "$ref": "#/$defs/ResourceSpec"
      },
      "description": "external state per machine frame: open at its start, close at its end",
      "title": "Resources",
      "type": "object"
    },
    "stategraph": {
      "const": 1,
      "description": "format version",
      "title": "Stategraph",
      "type": "integer"
    },
    "states": {
      "additionalProperties": {
        "$ref": "#/$defs/StateSpec"
      },
      "title": "States",
      "type": "object"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "vars": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentsystem.io/schemas/session.json",
  "title": "AgentSystem Session",
  "description": "Schema for persistent agent conversation sessions",
  "type": "object",
  "required": ["session_id", "user_id", "created_at", "updated_at", "title", "agent_name", "llm_profile", "messages"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier (UUID or short ID)",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "user_id": {
      "type": "string",
      "description": "User identifier (from JWT auth)",
      "minLength": 1,
      "maxLength": 255
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Session creation timestamp (ISO 8601)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)"
    },
    "title": {
      "type": "string",
      "description": "User-defined session title",
      "minLength": 1,
      "maxLength": 500,
      "default": "New Conversation"
    },
    "agent_name": {
      "type": "string",
      "description": "Agent used in this session",
      "minLength": 1,
      "maxLength": 100
    },
    "llm_profile": {
      "type": "string",
      "description": "LLM profile/model used",
      "minLength": 1,
      "maxLength": 100
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Nesting depth (1=root session, 2=sub-agent, 3=sub-sub-agent, etc.)"
    },
    "messages": {
      "type": "array",
      "description": "Conversation message history",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system", "tool"],
            "description": "Message role"
          },
          "content": {
            "description": "Message content (string or multimodal array)",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Optional name for tool messages"
          },
          "tool_call_id": {
            "type": "string",
            "description": "Tool call identifier"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool calls made by assistant",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional session metadata",
      "properties": {
        "message_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of messages"
        },
        "token_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Approximate total token count"
        },
        "last_agent_response": {
          "type": "string",
          "description": "Preview of last agent response"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User-defined tags"
        },
        "sub_agents": {
          "type": "object",
          "description": "Sub-agent instances created by this session",
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "object",
              "required": ["instance_id", "agent_type", "created_at", "status"],
              "properties": {
                "instance_id": {
                  "type": "string",
                  "description": "Unique sub-agent instance ID"
                },
                "agent_type": {
                  "type": "string",
                  "description": "Agent type (e.g., 'research_agent')"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Creation timestamp"
                },
                "last_used": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Last accessed timestamp"
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "archived"],
                  "description": "Current status"
                },
                "task_summary": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Task summary (max 200 chars)"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Nesting depth of child sub-agent"
                }
              }
            }
          }
        }
      }
    },
    "parent_session": {
      "type": "object",
      "description": "Link to parent session (for sub-agents)",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Parent session ID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Link creation timestamp"
        }
      },
      "required": ["session_id", "created_at"]
    }
  }
}

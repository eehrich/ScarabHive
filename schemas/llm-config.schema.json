          "type": "boolean"
        },
        "function_calling": {
          "default": true,
          "title": "Function Calling",
          "type": "boolean"
        },
        "image_input": {
          "default": false,
          "title": "Image Input",
          "type": "boolean"
        },
        "audio_input": {
          "default": false,
          "title": "Audio Input",
          "type": "boolean"
        },
        "video_input": {
          "default": false,
          "title": "Video Input",
          "type": "boolean"
        },
        "streaming": {
          "default": true,
          "title": "Streaming",
          "type": "boolean"
        },
        "json_mode": {

      "title": "TTSModelConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TTSProfile": {
      "description": "Named TTS profile that references a TTS model.\n\nNo voice here: the default voice lives on the MODEL entry\n(TTSModelConfig.voice) — a profile-level default_voice existed once,\nwas read by nobody, and only looked like configuration.",

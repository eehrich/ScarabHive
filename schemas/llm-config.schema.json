{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Configuration Schema",
  "description": "JSON Schema for AgentSystem LLM configuration (config/llm.yaml). GENERATED from agent_system.config.models by src/scripts/generate_config_schemas.py — do not edit by hand.",
  "type": "object",
  "required": [
    "llm_system"
  ],
  "additionalProperties": false,
  "properties": {
    "llm_system": {
      "description": "Complete LLM system configuration",
      "properties": {
        "httpx_timeouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTTPXTimeoutConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "openrouter_routing": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openrouter Routing"
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchSystemConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/LLMModelConfig"
          },
          "default": {},
          "title": "Models",
          "type": "object"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/LLMProfile"
          },
          "default": {},
          "title": "Profiles",
          "type": "object"
        },
        "default_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "normal",
          "title": "Default Profile"
        },
        "tts_models": {
          "additionalProperties": {
            "$ref": "#/$defs/TTSModelConfig"
          },
          "default": {},
          "title": "Tts Models",
          "type": "object"
        },
        "tts_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/TTSProfile"
          },
          "default": {},
          "title": "Tts Profiles",
          "type": "object"
        },
        "decision_models": {
          "additionalProperties": {
            "$ref": "#/$defs/DecisionModelConfig"
          },
          "default": {},
          "title": "Decision Models",
          "type": "object"
        },
        "decision_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/DecisionProfile"
          },
          "default": {},
          "title": "Decision Profiles",
          "type": "object"
        },
        "default_decision_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Decision Profile"
        }
      },
      "title": "LLMSystemConfig",
      "type": "object",
      "additionalProperties": false
    }
  },
  "$defs": {
    "BatchProviderConfig": {
      "description": "Configuration for a specific batch provider (Gemini/OpenAI).\n\nBatch APIs provide 50% cost reduction and separate rate limits\nfor non-time-critical workloads. Requests are collected, submitted\nas batch jobs, and results are polled asynchronously.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "collection_window_seconds": {
          "default": 10.0,
          "title": "Collection Window Seconds",
          "type": "number"
        },
        "max_requests_per_batch": {
          "default": 100,
          "title": "Max Requests Per Batch",
          "type": "integer"
        },
        "poll_interval_seconds": {
          "default": 10.0,
          "title": "Poll Interval Seconds",
          "type": "number"
        },
        "max_wait_hours": {
          "default": 24.0,
          "title": "Max Wait Hours",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "title": "Max Retries",
          "type": "integer"
        },
        "cancel_on_startup": {
          "default": true,
          "title": "Cancel On Startup",
          "type": "boolean"
        },
        "fallback_to_sync": {
          "default": false,
          "title": "Fallback To Sync",
          "type": "boolean"
        }
      },
      "title": "BatchProviderConfig",
      "type": "object",
      "additionalProperties": false
    },
    "BatchSystemConfig": {
      "description": "Global batch system configuration.\n\nCentralized configuration for batch processing. Models with\nprovider='batch' reference this config via their batch_provider field.",
      "properties": {
        "storage_path": {
          "default": "data/batch_jobs",
          "title": "Storage Path",
          "type": "string"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/BatchProviderConfig"
          },
          "title": "Providers",
          "type": "object"
        }
      },
      "title": "BatchSystemConfig",
      "type": "object",
      "additionalProperties": false
    },
    "DecisionModelConfig": {
      "additionalProperties": false,
      "description": "Individual decision model configuration.\n\nA decision model answers NAMED QUESTIONS about a piece of content with a\ntyped value and a probability — no message list, no prose, no tool calls\n(TypeSafe's Jev behind OpenRouter's ``/api/alpha/decisions`` is the first).\nIt therefore does not belong in ``models``: nothing here can serve\n``chat()``, and an entry there would be offered to every agent as a chat\nmodel and checked for a per-token price it does not have. OpenRouter's\nanswer carries its cost; one that carries none (a local Laya, TypeSafe\ndirect) is priced by the usage tracker from llm_pricing.yaml, by model.\n\nThe shape of ``TTSModelConfig`` minus its voice, for the same reason: a\nnon-chat client needs a connection and nothing from the chat knobs.",
      "properties": {
        "provider": {
          "default": "openrouter_decisions",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "request_timeout": {
          "default": 60,
          "title": "Request Timeout",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "required": [
        "model"
      ],
      "title": "DecisionModelConfig",
      "type": "object"
    },
    "DecisionProfile": {
      "additionalProperties": false,
      "description": "Named decision profile that references a decision model.",
      "properties": {
        "model_ref": {
          "title": "Model Ref",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "model_ref"
      ],
      "title": "DecisionProfile",
      "type": "object"
    },
    "HTTPXTimeoutConfig": {
      "description": "HTTPX timeout configuration",
      "properties": {
        "connect": {
          "default": 10.0,
          "title": "Connect",
          "type": "number"
        },
        "read": {
          "default": 180.0,
          "title": "Read",
          "type": "number"
        },
        "write": {
          "default": 10.0,
          "title": "Write",
          "type": "number"
        },
        "pool": {
          "default": 5.0,
          "title": "Pool",
          "type": "number"
        }
      },
      "title": "HTTPXTimeoutConfig",
      "type": "object",
      "additionalProperties": false
    },
    "LLMModelConfig": {
      "additionalProperties": false,
      "description": "Individual LLM model configuration",

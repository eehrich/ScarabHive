{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Configuration Schema",
  "description": "JSON Schema for AgentSystem LLM configuration (config/llm.yaml). GENERATED from agent_system.config.models by src/scripts/generate_config_schemas.py — do not edit by hand.",
  "type": "object",
  "required": [
    "llm_system"
  ],
  "additionalProperties": false,
  "properties": {
    "llm_system": {
      "description": "Complete LLM system configuration",
      "properties": {
        "httpx_timeouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTTPXTimeoutConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "openrouter_routing": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openrouter Routing"
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchSystemConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/LLMModelConfig"
          },
          "default": {},
          "title": "Models",
          "type": "object"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/LLMProfile"
          },
          "default": {},
          "title": "Profiles",
          "type": "object"
        },
        "default_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "normal",
          "title": "Default Profile"
        },
        "tts_models": {
          "additionalProperties": {
            "$ref": "#/$defs/TTSModelConfig"
          },
          "default": {},
          "title": "Tts Models",
          "type": "object"
        },
        "tts_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/TTSProfile"
          },
          "default": {},
          "title": "Tts Profiles",
          "type": "object"
        },
        "default_tts_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Tts Profile"
        }
      },
      "title": "LLMSystemConfig",
      "type": "object",
      "additionalProperties": false
    }
  },
  "$defs": {
    "BatchProviderConfig": {
      "description": "Configuration for a specific batch provider (Gemini/OpenAI).\n\nBatch APIs provide 50% cost reduction and separate rate limits\nfor non-time-critical workloads. Requests are collected, submitted\nas batch jobs, and results are polled asynchronously.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "collection_window_seconds": {
          "default": 10.0,
          "title": "Collection Window Seconds",
          "type": "number"
        },
        "max_requests_per_batch": {
          "default": 100,
          "title": "Max Requests Per Batch",
          "type": "integer"
        },
        "poll_interval_seconds": {
          "default": 10.0,
          "title": "Poll Interval Seconds",
          "type": "number"
        },
        "max_wait_hours": {
          "default": 24.0,
          "title": "Max Wait Hours",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "title": "Max Retries",
          "type": "integer"
        },
        "cancel_on_startup": {
          "default": true,
          "title": "Cancel On Startup",
          "type": "boolean"
        },
        "fallback_to_sync": {
          "default": false,
          "title": "Fallback To Sync",
          "type": "boolean"
        }
      },
      "title": "BatchProviderConfig",
      "type": "object",
      "additionalProperties": false
    },
    "BatchProvidersConfig": {
      "description": "Configuration for all batch providers.",
      "properties": {
        "gemini": {
          "$ref": "#/$defs/BatchProviderConfig"
        },
        "openai": {
          "$ref": "#/$defs/BatchProviderConfig"
        },
        "anthropic": {
          "$ref": "#/$defs/BatchProviderConfig"
        }
      },
      "title": "BatchProvidersConfig",
      "type": "object",
      "additionalProperties": false
    },
    "BatchSystemConfig": {
      "description": "Global batch system configuration.\n\nCentralized configuration for batch processing. Models with\nprovider='batch' reference this config via their batch_provider field.",
      "properties": {
        "storage_path": {
          "default": "data/batch_jobs",
          "title": "Storage Path",
          "type": "string"
        },
        "providers": {
          "$ref": "#/$defs/BatchProvidersConfig"
        }
      },
      "title": "BatchSystemConfig",
      "type": "object",
      "additionalProperties": false
    },
    "HTTPXTimeoutConfig": {
      "description": "HTTPX timeout configuration",
      "properties": {
        "connect": {
          "default": 10.0,
          "title": "Connect",
          "type": "number"
        },
        "read": {
          "default": 180.0,
          "title": "Read",
          "type": "number"
        },
        "write": {
          "default": 10.0,
          "title": "Write",
          "type": "number"
        },
        "pool": {
          "default": 5.0,
          "title": "Pool",
          "type": "number"
        }
      },
      "title": "HTTPXTimeoutConfig",
      "type": "object",
      "additionalProperties": false
    },
    "LLMModelConfig": {
      "additionalProperties": false,
      "description": "Individual LLM model configuration",
      "properties": {
        "provider": {
          "default": "ollama",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "context_window": {
          "default": 32768,
          "title": "Context Window",
          "type": "integer"
        },
        "ollama_mode": {
          "default": "openai_compat",
          "enum": [
            "openai_compat",
            "native"
          ],
          "title": "Ollama Mode",
          "type": "string"
        },
        "request_timeout": {
          "default": 120,
          "title": "Request Timeout",
          "type": "integer"
        },
        "parallel_tool_calls": {
          "default": true,
          "title": "Parallel Tool Calls",
          "type": "boolean"
        },
        "httpx_timeouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTTPXTimeoutConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCapabilitiesConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "include_thoughts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Thoughts"
        },
        "enable_prompt_caching": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Prompt Caching"
        },
        "thinking_budget": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget"
        },
        "thinking_level": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Level"
        },
        "modalities": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modalities"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "safety_settings": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safety Settings"
        },
        "service_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "prompt_cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Cache Key"
        },
        "prompt_cache_mode": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "multi_turn",
                "task_sequence",
                "one_shot",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Cache Mode"
        },
        "prompt_cache_marker_style": {
          "anyOf": [
            {
              "enum": [
                "openai",
                "anthropic",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Cache Marker Style"
        },
        "provider_routing": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Routing"
        },
        "reasoning_details_mode": {
          "anyOf": [
            {
              "enum": [
                "keep_last",
                "keep_all",
                "strip"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Details Mode"
        },
        "batch_provider": {
          "anyOf": [
            {
              "enum": [
                "gemini",
                "openai",
                "anthropic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Provider"
        },
        "extends": {
          "type": "string",
          "title": "Extends",
          "description": "Name of another model entry to inherit from. Merged field-wise; lists follow the +item/!pattern syntax of the agent type: chains."
        }
      },
      "title": "LLMModelConfig",
      "type": "object"
    },
    "LLMProfile": {
      "description": "LLM usage profile that references a model",
      "properties": {
        "model_ref": {
          "title": "Model Ref",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "max_steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        }
      },
      "required": [
        "model_ref"
      ],
      "title": "LLMProfile",
      "type": "object",
      "additionalProperties": false
    },
    "ModelCapabilitiesConfig": {
      "additionalProperties": false,
      "description": "What a model can take and produce.\n\nTHE definition — llm.capabilities.ModelCapabilities derives from this\nclass instead of repeating it. It used to be a second copy, field for\nfield, and a new capability had to be added twice.",
      "properties": {
        "tools": {
          "default": true,
          "title": "Tools",
          "type": "boolean"
        },
        "function_calling": {
          "default": true,
          "title": "Function Calling",
          "type": "boolean"
        },
        "image_input": {
          "default": false,
          "title": "Image Input",
          "type": "boolean"
        },
        "audio_input": {
          "default": false,
          "title": "Audio Input",
          "type": "boolean"
        },
        "video_input": {
          "default": false,
          "title": "Video Input",
          "type": "boolean"
        },
        "streaming": {
          "default": true,
          "title": "Streaming",
          "type": "boolean"
        },
        "json_mode": {
          "default": false,
          "title": "Json Mode",
          "type": "boolean"
        },
        "supported_api_types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supported Api Types"
        },
        "default_api_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Api Type"
        },
        "max_image_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Image Size"
        },
        "max_image_resolution": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Image Resolution"
        },
        "min_image_resolution": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Image Resolution"
        },
        "supported_image_formats": {
          "items": {
            "type": "string"
          },
          "title": "Supported Image Formats",
          "type": "array"
        },
        "image_detail_control": {
          "default": false,
          "title": "Image Detail Control",
          "type": "boolean"
        },
        "max_audio_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Audio Size"
        },
        "max_audio_duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Audio Duration"
        },
        "supported_audio_formats": {
          "items": {
            "type": "string"
          },
          "title": "Supported Audio Formats",
          "type": "array"
        },
        "max_video_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Video Size"
        },
        "max_video_duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Video Duration"
        },
        "supported_video_formats": {
          "items": {
            "type": "string"
          },
          "title": "Supported Video Formats",
          "type": "array"
        },
        "supports_files_api": {
          "default": false,
          "title": "Supports Files Api",
          "type": "boolean"
        },
        "supports_file_uploads": {
          "default": false,
          "title": "Supports File Uploads",
          "type": "boolean"
        }
      },
      "title": "ModelCapabilitiesConfig",
      "type": "object"
    },
    "TTSModelConfig": {
      "description": "Individual TTS model configuration.\n\nDefines a TTS backend (e.g. Gemini TTS) with its connection and\ngeneration parameters.",
      "properties": {
        "provider": {
          "default": "gemini_tts",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        },
        "request_timeout": {
          "default": 300,
          "title": "Request Timeout",
          "type": "integer"
        },
        "max_retries": {
          "default": 3,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "required": [
        "model"
      ],
      "title": "TTSModelConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TTSProfile": {
      "description": "Named TTS profile that references a TTS model.",
      "properties": {
        "model_ref": {
          "title": "Model Ref",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "default_voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Voice"
        }
      },
      "required": [
        "model_ref"
      ],
      "title": "TTSProfile",
      "type": "object",
      "additionalProperties": false
    }
  }
}

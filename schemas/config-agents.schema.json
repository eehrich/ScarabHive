{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yourusername/AgentSystem/schemas/config-agents.json",
  "title": "Configuration-Based Agent Definition",
  "description": "JSON Schema for validating configuration-based agent definitions in AgentSystem (Epic 0043)",
  "type": "object",
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "type": "object",
      "required": ["enabled", "description", "base_type", "agent_config"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this agent is active and should be discovered",
          "default": true
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the agent's purpose and capabilities",
          "minLength": 10,
          "maxLength": 500
        },
        "base_type": {
          "type": "string",
          "description": "Base agent class to use",
          "enum": ["agent", "server"],
          "default": "agent"
        },
        "agent_config": {
          "type": "object",
          "description": "Agent configuration including LLM, tools, and behavior settings",
          "required": ["llm_profile"],
          "properties": {
            "llm_profile": {
              "type": "string",
              "description": "LLM profile name from llm.yaml (e.g., 'turbo', 'normal', 'deepseek')",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "examples": ["turbo", "normal", "deepseek", "o1-mini", "o1"]
            },
            "max_steps": {
              "type": "integer",
              "description": "Maximum reasoning steps allowed for this agent",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "system_prompt": {
              "type": "string",
              "description": "Inline system prompt text (alternative to system_template)",
              "minLength": 20
            },
            "system_template": {
              "type": "string",
              "description": "Path to system prompt template file relative to project root",
              "pattern": "^config/prompts/.*\\.yaml$",
              "examples": ["config/prompts/financial_analyst_prompt.yaml"]
            },
            "tools": {
              "type": "object",
              "description": "Tool access control configuration",
              "properties": {
                "allowed": {
                  "type": "array",
                  "description": "List of allowed tool patterns. Use '*' wildcards for flexible matching.",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*/([a-z_][a-z0-9_]*|\\*)$",
                    "examples": [
                      "yahoo_finance/*",
                      "web_scraper/scrape_url",
                      "basic_operations/wait_for"
                    ]
                  },
                  "default": []
                },
                "blocked": {
                  "type": "array",
                  "description": "List of blocked tool patterns. Takes precedence over allowed.",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*/([a-z_][a-z0-9_]*|\\*)$",
                    "examples": [
                      "ssh_control/*",
                      "script_interpreter/*"
                    ]
                  },
                  "default": []
                }
              },
              "additionalProperties": false
            },
            "tool_descriptions": {
              "type": "object",
              "description": "Custom descriptions for this agent's own tools (inherited from base_type). Allows overriding generic descriptions with context-specific ones.",
              "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                  "type": "string",
                  "description": "Custom description for the tool",
                  "minLength": 10,
                  "maxLength": 500
                }
              },
              "examples": [
                {
                  "sysadmin_agent_execute_task": "Execute system administration tasks with SSH access to production and development servers",
                  "sysadmin_agent_list_tools": "List all SSH and system administration tools"
                }
              ],
              "additionalProperties": false
            },
            "context_management": {
              "type": "object",
              "description": "Context window management configuration",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable automatic context window management",
                  "default": true
                },
                "strategy": {
                  "type": "string",
                  "description": "Strategy for handling context overflow",
                  "enum": [
                    "SUMMARIZE_OLDEST",
                    "TRUNCATE",
                    "TRUNCATE_OLDEST",
                    "SLIDING_WINDOW",
                    "SMART_COMPRESSION"
                  ],
                  "default": "SUMMARIZE_OLDEST"
                },
                "preserve_recent_messages": {
                  "type": "integer",
                  "description": "Number of recent messages to keep intact",
                  "minimum": 1,
                  "maximum": 100,
                  "default": 10
                },
                "summarization_threshold": {
                  "type": "number",
                  "description": "Threshold (0.0-1.0) of context usage to trigger summarization",
                  "minimum": 0.0,
                  "maximum": 1.0,
                  "default": 0.7
                },
                "summarizer_llm_profile": {
                  "type": "string",
                  "description": "LLM profile to use for summarization (typically 'turbo' for speed)",
                  "default": "turbo"
                }
              },
              "additionalProperties": false
            },
            "hooks": {
              "type": "object",
              "description": "Plugin hook system configuration for this agent",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable hook execution for this agent (global enable/disable)",
                  "default": true
                },
                "disabled_hooks": {
                  "type": "array",
                  "description": "List of hook names to disable for this agent (e.g., 'markdown_formatter.format_markdown_output')",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
                    "examples": [
                      "markdown_formatter.inject_markdown_system_prompt",
                      "request_logger.log_pre_llm",
                      "llm_message_validator.validate_messages"
                    ]
                  },
                  "uniqueItems": true,
                  "default": []
                },
                "enabled_hooks": {
                  "type": "array",
                  "description": "List of hook names to explicitly enable (useful when hooks.enabled=false but you want specific hooks). If empty and hooks.enabled=true, all hooks run.",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$"
                  },
                  "uniqueItems": true,
                  "default": []
                },
                "hook_overrides": {
                  "type": "object",
                  "description": "Per-hook configuration overrides for this agent",
                  "patternProperties": {
                    "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$": {
                      "type": "object",
                      "description": "Override configuration for a specific hook",
                      "properties": {
                        "enabled": {
                          "type": "boolean",
                          "description": "Enable/disable this specific hook"
                        },
                        "timeout": {
                          "type": "number",
                          "description": "Timeout in seconds for this hook",
                          "minimum": 0.1,
                          "maximum": 120.0
                        },
                        "config": {
                          "type": "object",
                          "description": "Hook-specific configuration overrides",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "default": {},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "oneOf": [
            {
              "required": ["system_prompt"],
              "not": {
                "required": ["system_template"]
              }
            },
            {
              "required": ["system_template"],
              "not": {
                "required": ["system_prompt"]
              }
            }
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional metadata for documentation, organization, and visibility control",
          "properties": {
            "author": {
              "type": "string",
              "description": "Author or team name",
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "description": "Version string (semantic versioning recommended)",
              "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?(\\+[a-z0-9.-]+)?$",
              "examples": ["1.0.0", "2.1.3-beta", "1.0.0+20240101"]
            },
            "tags": {
              "type": "array",
              "description": "Tags for categorization and search",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 30
              },
              "uniqueItems": true,
              "maxItems": 10
            },
            "category": {
              "type": "string",
              "description": "Primary category",
              "enum": [
                "financial",
                "development",
                "research",
                "support",
                "general",
                "analysis",
                "automation",
                "communication"
              ]
            },
            "visibility": {
              "type": "string",
              "description": "Controls where the agent appears (UI dropdown, tool discovery, both, or neither)",
              "enum": ["ui", "tool", "both", "private"],
              "default": "private",
              "examples": ["ui", "tool", "both", "private"]
            },
            "changelog": {
              "type": "string",
              "description": "Recent changes or notes",
              "maxLength": 500
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "financial_analyst": {
        "enabled": true,
        "description": "Professional financial analyst for stock market analysis and investment insights",
        "base_type": "agent",
        "agent_config": {
          "llm_profile": "turbo",
          "max_steps": 20,
          "system_template": "config/prompts/financial_analyst_prompt.yaml",
          "tools": {
            "allowed": [
              "yahoo_finance/*",
              "web_scraper/*",
              "duckduckgo_search/*"
            ],
            "blocked": [
              "ssh_control/*",
              "script_interpreter/*"
            ]
          },
          "context_management": {
            "enabled": true,
            "strategy": "SUMMARIZE_OLDEST",
            "preserve_recent_messages": 8
          }
        },
        "metadata": {
          "author": "AgentSystem",
          "version": "1.0.0",
          "tags": ["finance", "stocks", "analysis"],
          "category": "financial",
          "visibility": "ui"
        }
      }
    },
    {
      "simple_qa": {
        "enabled": true,
        "description": "Lightweight Q&A agent for general knowledge questions",
        "base_type": "agent",
        "agent_config": {
          "llm_profile": "normal",
          "max_steps": 5,
          "system_prompt": "You are a helpful AI assistant for answering general knowledge questions.\nProvide accurate, concise answers. If you don't know something, say so honestly.",
          "tools": {
            "allowed": [],
            "blocked": []
          },
          "context_management": {
            "enabled": false
          }
        },
        "metadata": {
          "author": "AgentSystem",
          "version": "1.0.0",
          "tags": ["qa", "simple", "knowledge"],
          "category": "general",
          "visibility": "ui"
        }
      }
    }
  ],
  "definitions": {
    "agent_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 50,
      "description": "Agent name: lowercase, starts with letter, alphanumeric + underscores"
    },
    "tool_pattern": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*/([a-z_][a-z0-9_]*|\\*)$",
      "description": "Tool pattern: plugin_name/tool_name or plugin_name/* for all tools"
    },
    "llm_profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "LLM profile name from llm.yaml"
    },
    "prompt_template_path": {
      "type": "string",
      "pattern": "^config/prompts/.*\\.yaml$",
      "description": "Path to prompt template file"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?(\\+[a-z0-9.-]+)?$",
      "description": "Semantic version string (major.minor.patch)"
    },
    "visibility_mode": {
      "type": "string",
      "enum": ["ui", "tool", "both", "private"],
      "description": "Agent visibility mode: 'ui' (UI dropdown only), 'tool' (available as tool only), 'both' (UI + tool), 'private' (neither)"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugins Configuration Schema",
  "description": "JSON Schema for AgentSystem plugin configuration (config/plugins.yaml). GENERATED from agent_system.config.models by src/scripts/generate_config_schemas.py — do not edit by hand.",
  "type": "object",
  "required": [
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "plugins": {
      "description": "Configuration for local plugins (matches config/plugins.yaml)",
      "properties": {
        "plugin_dirs": {
          "items": {
            "type": "string"
          },
          "title": "Plugin Dirs",
          "type": "array"
        },
        "default_config": {
          "$ref": "#/$defs/ToolServerConfig"
        },
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolServerConfig"
          },
          "title": "Servers",
          "type": "object"
        }
      },
      "title": "PluginsConfig",
      "type": "object",
      "additionalProperties": false
    },
    "hooks": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Global hook settings: the top-level ``hooks:`` section of\nconfig/plugins.yaml or any included file, merged by load_settings like\n``plugins:``. Not the per-agent ``agent_config.hooks``.",
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "default": true,
                  "title": "Enabled",
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_timeout": {
              "anyOf": [
                {
                  "default": 30.0,
                  "exclusiveMinimum": 0,
                  "title": "Default Timeout",
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "overrides": {
              "anyOf": [
                {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/HookOverrideConfig"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": "Overrides",
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "GlobalHooksConfig",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "description": "Configuration for individual agent instances (matches type comment in mcp.yaml)",
      "properties": {
        "llm_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "normal",
          "title": "Llm Profile"
        },
        "llm_profile_advanced": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Profile Advanced"
        },
        "inherit_parent_llm": {
          "default": false,
          "title": "Inherit Parent Llm",
          "type": "boolean"
        },
        "llm_profile_fallbacks": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Profile Fallbacks"
        },
        "llm_params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Params"
        },
        "fallback_recovery_seconds": {
          "default": 3600,
          "title": "Fallback Recovery Seconds",
          "type": "integer"
        },
        "max_steps": {
          "default": 20,
          "title": "Max Steps",
          "type": "integer"
        },
        "tools": {
          "$ref": "#/$defs/ToolConfig"
        },
        "hooks": {
          "anyOf": [
            {
              "$ref": "#/$defs/HooksConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "system_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Template"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "skills": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/SkillsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "template_vars": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Vars"
        },
        "timeouts": {
          "$ref": "#/$defs/TimeoutConfig"
        },
        "loop_detection": {
          "$ref": "#/$defs/LoopDetectionConfig"
        },
        "reasoning_loop": {
          "$ref": "#/$defs/ReasoningLoopConfig"
        },
        "auto_escalate_on_stuck": {
          "default": false,
          "title": "Auto Escalate On Stuck",
          "type": "boolean"
        },
        "escalate_rounds": {
          "default": 2,
          "title": "Escalate Rounds",
          "type": "integer"
        },
        "escalate_max_calls": {
          "default": 6,
          "title": "Escalate Max Calls",
          "type": "integer"
        },
        "escalate_error_streak": {
          "default": 2,
          "title": "Escalate Error Streak",
          "type": "integer"
        },
        "output_cap_notes": {
          "default": 0,
          "title": "Output Cap Notes",
          "type": "integer"
        }
      },
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentMetadata": {
      "description": "Metadata for agent configuration.\n\nProvides additional information about agents for discoverability,\ncategorization, and visibility control.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "visibility": {
          "default": "private",
          "enum": [
            "ui",
            "tool",
            "both",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "min_role": {
          "anyOf": [
            {
              "enum": [
                "guest",
                "user",
                "admin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Role"
        }
      },
      "title": "AgentMetadata",
      "type": "object",
      "additionalProperties": false
    },
    "HooksConfig": {
      "description": "Hook system configuration for individual agents.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Overrides",
          "type": "object"
        }
      },
      "title": "HooksConfig",
      "type": "object",
      "additionalProperties": false
    },
    "LoopDetectionConfig": {
      "description": "Configuration for tool call loop detection.\n\nPrevents agents from getting stuck in infinite loops calling\nthe same tool(s) repeatedly with identical arguments.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "history_size": {
          "default": 20,
          "title": "History Size",
          "type": "integer"
        },
        "exact_match_threshold": {
          "default": 3,
          "title": "Exact Match Threshold",
          "type": "integer"
        },
        "sequence_threshold": {
          "default": 2,
          "title": "Sequence Threshold",
          "type": "integer"
        },
        "block_after_threshold": {
          "default": 5,
          "title": "Block After Threshold",
          "type": "integer"
        },
        "auto_unblock_after_steps": {
          "default": 3,
          "title": "Auto Unblock After Steps",
          "type": "integer"
        }
      },
      "title": "LoopDetectionConfig",
      "type": "object",
      "additionalProperties": false
    },
    "ReasoningLoopConfig": {
      "description": "Configuration for reasoning loop detection.\n\nCatches a model that is stuck inside its own THINKING and keeps paying\nfor it — measured: one run spent 65.535 reasoning tokens over 20 minutes\nrepeating a single sentence. The run loop aborts such a call and retries\nthe same model once.\n\nOnly the two knobs worth turning live here. The measurement geometry\n(window size, check interval, compared piece length) stays in\n``servers/agent/reasoning_loop.py``: those three were calibrated TOGETHER\nwith the threshold, so changing one here would quietly make the threshold\nmean something else.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "repetition_threshold": {
          "default": 0.5,
          "title": "Repetition Threshold",
          "type": "number"
        }
      },
      "title": "ReasoningLoopConfig",
      "type": "object",
      "additionalProperties": false
    },
    "SkillsConfig": {
      "description": "Which packaged skills an agent gets (see docs/skills_design.md).\n\n``always`` skills are appended to the system prompt at render time — the\nagent HAS the knowledge, it does not have to ask for it. Deterministic and\ncache-friendly (part of the stable prefix).\n\nAccepts a bare list as shorthand, so both forms work::\n\n    skills: [\"house-style\"]              # == always: [\"house-style\"]\n    skills:\n      always: [\"house-style\"]\n\n``on_demand`` skills are NOT put in the prompt — only a one-line index of\nthem is, so the agent knows they exist and can pull the body (and any\nbundled ``reference/`` files) with the ``skills`` plugin's tools. Use it for\nmaterial that is large and only occasionally needed; anything the agent\nneeds most of the time belongs in ``always``, where it cannot be forgotten.",
      "properties": {
        "always": {
          "items": {
            "type": "string"
          },
          "title": "Always",
          "type": "array"
        },
        "on_demand": {
          "items": {
            "type": "string"
          },
          "title": "On Demand",
          "type": "array"
        }
      },
      "title": "SkillsConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TimeoutConfig": {
      "description": "Timeout configuration for agent execution to prevent deadlocks.",
      "properties": {
        "status_queue_put_timeout": {
          "default": 5.0,
          "title": "Status Queue Put Timeout",
          "type": "number"
        },
        "llm_task_max_iterations": {
          "default": 864000,
          "title": "Llm Task Max Iterations",
          "type": "integer"
        },
        "session_lock_timeout": {
          "default": 5.0,
          "title": "Session Lock Timeout",
          "type": "number"
        },
        "tool_cleanup_timeout": {
          "default": 30.0,
          "title": "Tool Cleanup Timeout",
          "type": "number"
        }
      },
      "title": "TimeoutConfig",
      "type": "object",
      "additionalProperties": false
    },
    "ToolConfig": {
      "description": "Tool access control configuration",
      "properties": {
        "allowed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed"
        },
        "blocked": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocked"
        }
      },
      "title": "ToolConfig",
      "type": "object",
      "additionalProperties": false
    },
    "ToolServerConfig": {
      "additionalProperties": true,
      "description": "tool server configuration (matches type comment in mcp.yaml for default_config)",
      "properties": {
        "type": {
          "default": "basic_agent",
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "self_tool_descriptions": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Self Tool Descriptions"
        },
        "agent_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ToolServerConfig",
      "type": "object",
      "required": [
        "type"
      ]
    },
    "HookOrderConfig": {
      "additionalProperties": false,
      "description": "Where a hook runs relative to others (names, or the virtual begin/end).",
      "properties": {
        "before": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "title": "Before",
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "title": "After",
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "HookOrderConfig",
      "type": "object"
    },
    "HookOverrideConfig": {
      "additionalProperties": false,
      "description": "Operator override for one hook. Only the fields that are set apply.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookOrderConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HookOverrideConfig",
      "type": "object"
    }
  }
}

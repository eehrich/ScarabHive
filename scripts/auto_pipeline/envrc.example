# scripts/auto_pipeline/envrc.example
#
# Operator template for the auto-pipeline secrets file.
# Copy to <repo-root>/.envrc and fill in real values:
#
#     cp scripts/auto_pipeline/envrc.example .envrc
#     chmod 600 .envrc
#
# NEVER commit .envrc — it lives in .gitignore on purpose.
# All scripts in scripts/auto_pipeline/ load this file via lib/common.sh.

# --- Feedback-API authentication ----------------------------------------
# X-Writer-Key header value used by writer_jobs.feedback_sync.
# Dedicated to this writer host; rotate with the server-side counterpart.
AURITALE_WRITER_KEY=""

# Base URL for the production feedback-api (Go service). The writer pulls
# /internal/feedback/open from here and PATCHes status back.
# Example: https://api1.auritale.com:8081
AURITALE_FEEDBACK_API_BASE="https://api1.auritale.com:8081"

# --- Deploy target -------------------------------------------------------
# SSH host string used for rsync + ssh during writer-publish deploy-book.
# MUST be reachable from the writer host. Dedicated SSH key recommended.
AURITALE_DEPLOY_HOST="operator@api1.auritale.com"

# Path to the private SSH key used for deploy. Should be a dedicated key,
# NOT the operator's personal key, scoped (via authorized_keys command="")
# to /opt/auritale/server/books on the target.
AURITALE_DEPLOY_SSH_KEY="$HOME/.ssh/auritale_deploy"

# --- Alerting ------------------------------------------------------------
# If set, lib/common.sh::alert() pipes failures to `mail -s ... <addr>`.
# Leave empty to disable mail alerts (failures still land in the log).
AURITALE_ALERT_MAIL=""

# --- Logging + runtime ---------------------------------------------------
# Per-script log directory. Default: /var/log/auritale_writer
# Override here for local dev (e.g. ~/.local/state/auritale_writer/log).
AUTO_PIPELINE_LOG_DIR="/var/log/auritale_writer"

# Runtime directory for lockfiles + pause sentinel + health state.
# Default: /tmp/auritale_writer
AUTO_PIPELINE_RUNTIME_DIR="/tmp/auritale_writer"

# --- Cron schedules (optional overrides) ---------------------------------
# install_cron.sh respects these; defaults match the spec.
# Format: standard cron 5-field expression.
AUTO_PIPELINE_CRON_PRODUCER="*/15 * * * *"
AUTO_PIPELINE_CRON_WORKERS="*/5 * * * *"
AUTO_PIPELINE_CRON_FEEDBACK_SYNC="*/30 * * * *"
AUTO_PIPELINE_CRON_DEPLOY_QUEUE="*/15 * * * *"
AUTO_PIPELINE_CRON_HEALTH_CHECK="*/5 * * * *"
AUTO_PIPELINE_CRON_SWEEP_STALE="*/20 * * * *"

# --- Health check tuning -------------------------------------------------
# URL probed by run_health_check.sh. Default: $AURITALE_FEEDBACK_API_BASE/health.
# Override here if a separate health endpoint is preferred.
AURITALE_HEALTH_URL=""

# Number of consecutive bad ticks before the pipeline pauses itself.
AURITALE_HEALTH_FAIL_THRESHOLD="3"
